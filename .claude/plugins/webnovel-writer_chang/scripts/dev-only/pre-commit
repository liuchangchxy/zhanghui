#!/usr/bin/env bash
# webnovel-writer_chang manifest pre-commit guard.
# 源文件位置：scripts/dev-only/pre-commit（版本控制里）。
# 由 setup_dev_env.sh 复制到 .git/hooks/pre-commit 后生效。
# .git/hooks/ 不进 git；改这文件后跑一次 setup_dev_env.sh 同步。
#
# 目的：阻止无效 plugin.json 进入历史。无效 manifest 会让 Claude Code
# 拒绝加载整个 plugin —— 斜杠命令、skills、agents 全部消失。
#
# 三条设计原则（改动前先读）：
#   1. 校验调用方所在的 worktree，不是硬编码的主工作区。
#   2. 校验 index 的内容，不是磁盘工作区的内容 —— 进历史的是前者。
#   3. 只在 manifest 或 skills//commands/ 结构真的变了时触发。触发面放宽
#      会产生因果不成立的拦截，那种拦截会被当成工具故障而被绕过。

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
PLUGIN_REL=".claude/plugins/webnovel-writer_chang"
PLUGIN_ROOT="$REPO_ROOT/$PLUGIN_REL"
MANIFEST_REL="$PLUGIN_REL/.claude-plugin/plugin.json"
VALIDATOR="$PLUGIN_ROOT/scripts/dev-only/validate_plugin_manifest.sh"

STAGED=$(git -C "$REPO_ROOT" diff --cached --name-status || true)

# 触发条件 1：manifest 本身被改动
MANIFEST_CHANGED=$(printf '%s\n' "$STAGED" | awk -v m="$MANIFEST_REL" '$NF == m')

# 触发条件 2：skills/ 或 commands/ 下有文件新增/删除/改名
# —— manifest 声明的目录可能整个消失。纯内容修改（M）不算。
STRUCTURE_CHANGED=$(printf '%s\n' "$STAGED" \
    | awk -v p="$PLUGIN_REL" '$1 ~ /^[ADR]/ && $NF ~ "^" p "/(skills|commands)/"')

if [ -z "$MANIFEST_CHANGED" ] && [ -z "$STRUCTURE_CHANGED" ]; then
    exit 0
fi

if [ ! -x "$VALIDATOR" ] && [ ! -f "$VALIDATOR" ]; then
    exit 0
fi

# manifest 不在 index 里（插件整体被删 / 首次引入还没 stage）→ 无可校验
if ! git -C "$REPO_ROOT" cat-file -e ":$MANIFEST_REL" 2>/dev/null; then
    exit 0
fi

STAGED_MANIFEST="$(mktemp)"
trap 'rm -f "$STAGED_MANIFEST"' EXIT
git -C "$REPO_ROOT" show ":$MANIFEST_REL" > "$STAGED_MANIFEST"

echo "→ pre-commit: manifest 或 skills/commands 结构有改动，校验 staged manifest..."
echo ""
echo "Triggering changes:"
printf '%s\n' "$MANIFEST_CHANGED" "$STRUCTURE_CHANGED" | grep -v '^$' | sed 's/^/  /' || true
echo ""

if ! bash "$VALIDATOR" "$PLUGIN_ROOT" "$STAGED_MANIFEST"; then
    echo ""
    echo "✘ pre-commit BLOCKED: 这份 manifest 会让 Claude Code 拒绝加载整个 plugin。"
    echo "  后果：斜杠命令 / skills / agents 全部消失，且不会有明显报错。"
    echo "  请修好上面列出的字段再提交 —— 这道检查不该被跳过。"
    exit 1
fi

echo ""
echo "✓ manifest OK — commit allowed"
exit 0