{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuchangchxy/zhanghui/benchmarks/longform/schemas/stage1-dataset-manifest-v1.schema.json",
  "title": "Stage 1 Ten-Chapter Dataset Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "protocol_revision",
    "stage0_source_run",
    "systems",
    "evaluator_runtime_lock_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "zhanghui-stage1-dataset-manifest/v1"
    },
    "scenario_id": {
      "const": "pilot-tide-archive-001"
    },
    "protocol_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "stage0_source_run": {
      "const": "runs/pilot-tide-archive-001/run-002-track-a/"
    },
    "evaluator_runtime_lock_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "systems": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jarvis-write",
        "ai-novel-generator",
        "zhanghui"
      ],
      "properties": {
        "jarvis-write": {
          "$ref": "#/$defs/system"
        },
        "ai-novel-generator": {
          "$ref": "#/$defs/system"
        },
        "zhanghui": {
          "$ref": "#/$defs/system"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "origin",
        "prose_sha256",
        "manifest_sha256"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "origin": {
          "enum": [
            "stage0_reused",
            "stage1_generated"
          ]
        },
        "prose_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "native_receipt_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_source_sha",
        "stage0_state_snapshot_sha256",
        "chapters"
      ],
      "properties": {
        "execution_source_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "stage0_state_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "chapters": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/chapter"
          }
        }
      }
    }
  }
}
