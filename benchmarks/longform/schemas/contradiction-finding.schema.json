{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuchangchxy/zhanghui/benchmarks/longform/schemas/contradiction-finding.schema.json",
  "title": "Long-Form Benchmark Contradiction Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "finding_id",
    "evaluator_version",
    "evaluator_sha256",
    "sample_id",
    "taxonomy",
    "status",
    "confidence",
    "evidence",
    "explanation"
  ],
  "properties": {
    "schema_version": {
      "const": "zhanghui-longform-contradiction-finding/v1"
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "description": "Blinded sample identity; must not encode A/B/C."
    },
    "taxonomy": {
      "enum": [
        "FACTUAL_ENTITY",
        "CHARACTER_STATE",
        "RELATIONSHIP",
        "WORLD_RULE",
        "TEMPORAL",
        "LOCATION",
        "OBJECT_OWNERSHIP",
        "EPISTEMIC",
        "OPEN_LOOP"
      ]
    },
    "status": {
      "enum": [
        "CONFIRMED",
        "UNRESOLVED",
        "REJECTED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "claim_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "audit": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "auditor": {
          "type": "string"
        },
        "decision": {
          "enum": [
            "CONFIRMED",
            "UNRESOLVED",
            "REJECTED"
          ]
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "source_file",
        "start_line",
        "end_line",
        "role",
        "summary"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "start_line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        },
        "role": {
          "enum": [
            "EARLIER_EVIDENCE",
            "LATER_EVIDENCE",
            "CONTEXT",
            "OPEN_LOOP_SOURCE"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
