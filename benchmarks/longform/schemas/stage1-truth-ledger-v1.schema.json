{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuchangchxy/zhanghui/benchmarks/longform/schemas/stage1-truth-ledger-v1.schema.json",
  "title": "Stage 1 Prose-Grounded Truth Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extractor_version",
    "sample_id",
    "manuscript_sha256",
    "items",
    "checkpoints"
  ],
  "properties": {
    "schema_version": {
      "const": "zhanghui-stage1-truth-ledger/v1"
    },
    "extractor_version": {
      "const": "stage1-truth-ledger-extractor-v1"
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "manuscript_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/item"
      }
    },
    "checkpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ch03",
        "ch06",
        "ch10"
      ],
      "properties": {
        "ch03": {
          "$ref": "#/$defs/checkpoint"
        },
        "ch06": {
          "$ref": "#/$defs/checkpoint"
        },
        "ch10": {
          "$ref": "#/$defs/checkpoint"
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "quote"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "category",
        "subject",
        "predicate",
        "value",
        "epistemic_status",
        "time_scope",
        "valid_from_chapter",
        "valid_to_chapter",
        "material",
        "evidence"
      ],
      "properties": {
        "item_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "FACTUAL_ENTITY",
            "CHARACTER_STATE",
            "RELATIONSHIP",
            "WORLD_RULE",
            "TEMPORAL",
            "LOCATION",
            "OBJECT_OWNERSHIP",
            "EPISTEMIC",
            "OPEN_LOOP"
          ]
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        "epistemic_status": {
          "enum": [
            "OBJECTIVE",
            "ATTRIBUTED_CLAIM",
            "UNRESOLVED",
            "SUBJECTIVE"
          ]
        },
        "time_scope": {
          "enum": [
            "PRESENT",
            "HISTORICAL",
            "FLASHBACK_RECONSTRUCTION",
            "UNKNOWN"
          ]
        },
        "valid_from_chapter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "valid_to_chapter": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 10
        },
        "material": {
          "type": "boolean"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "active_material_item_ids"
      ],
      "properties": {
        "chapter": {
          "enum": [
            3,
            6,
            10
          ]
        },
        "active_material_item_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    }
  }
}
