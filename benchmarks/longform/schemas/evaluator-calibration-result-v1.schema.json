{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuchangchxy/zhanghui/benchmarks/longform/schemas/evaluator-calibration-result-v1.schema.json",
  "title": "Stage 1 Evaluator Calibration Result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluator_version",
    "runtime",
    "prompt_sha256",
    "cases_sha256",
    "gold_sha256",
    "case_results",
    "metrics",
    "passed"
  ],
  "properties": {
    "schema_version": {
      "const": "zhanghui-stage1-evaluator-calibration-result/v1"
    },
    "evaluator_version": {
      "const": "stage1-evaluator-v1"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human_label",
        "machine_label",
        "model_id_verifiability"
      ],
      "properties": {
        "human_label": {
          "type": "string",
          "minLength": 1
        },
        "machine_label": {
          "type": "string",
          "minLength": 1
        },
        "model_id_verifiability": {
          "enum": [
            "EXACT",
            "PARTIAL_INTERNAL_LABEL_ONLY",
            "UNKNOWN"
          ]
        }
      }
    },
    "prompt_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cases_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "gold_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "case_results": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "conversation_id",
          "material_violation",
          "primary_category",
          "schema_valid"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^C(0[1-9]|1[0-2])$"
          },
          "conversation_id": {
            "type": "string",
            "minLength": 1
          },
          "material_violation": {
            "type": "boolean"
          },
          "primary_category": {
            "type": [
              "string",
              "null"
            ]
          },
          "schema_valid": {
            "type": "boolean"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_valid_rate",
        "material_precision",
        "material_recall",
        "taxonomy_macro_f1",
        "false_confirm_rate"
      ],
      "properties": {
        "schema_valid_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "material_precision": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "material_recall": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "taxonomy_macro_f1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "false_confirm_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "passed": {
      "type": "boolean"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
