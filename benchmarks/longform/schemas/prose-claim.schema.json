{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuchangchxy/zhanghui/benchmarks/longform/schemas/prose-claim.schema.json",
  "title": "Prose-Grounded Benchmark Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "sample_id",
    "chapter",
    "claim_type",
    "subject",
    "predicate",
    "object_or_value",
    "truth_status",
    "evidence",
    "audit_status"
  ],
  "properties": {
    "schema_version": {
      "const": "zhanghui-longform-prose-claim/v1"
    },
    "claim_id": {
      "type": "string",
      "minLength": 1
    },
    "sample_id": {
      "type": "string",
      "minLength": 1,
      "description": "Blinded sample identity."
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "claim_type": {
      "enum": [
        "WORLD_FACT",
        "CHARACTER_BELIEF",
        "CHARACTER_SPEECH",
        "RUMOR_OR_REPORT",
        "HYPOTHETICAL",
        "OPEN_DEVELOPMENT"
      ]
    },
    "subject": {
      "type": "string",
      "minLength": 1
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "object_or_value": {},
    "holder": {
      "type": [
        "string",
        "null"
      ],
      "description": "Character/agent that holds or voices the proposition when claim_type is epistemic."
    },
    "truth_status": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNRESOLVED",
        "NOT_APPLICABLE"
      ]
    },
    "story_time": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true,
      "description": "Optional story-world valid-time representation; must not be inferred merely from chapter order."
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_file",
          "start_line",
          "end_line",
          "summary"
        ],
        "properties": {
          "source_file": {
            "type": "string",
            "minLength": 1
          },
          "start_line": {
            "type": "integer",
            "minimum": 1
          },
          "end_line": {
            "type": "integer",
            "minimum": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "audit_status": {
      "enum": [
        "GOLD",
        "AUDITED",
        "PROVISIONAL",
        "REJECTED"
      ]
    },
    "auditor_notes": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
