{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/liuchangchxy/zhanghui/benchmarks/longform/schemas/stage1-evaluator-report-v1.schema.json",
  "title": "Stage 1 Blinded Evaluator Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evaluator_version",
    "mode",
    "sample_id",
    "manuscript_sha256",
    "runtime_label",
    "report"
  ],
  "properties": {
    "schema_version": {
      "const": "zhanghui-stage1-evaluator-report/v1"
    },
    "evaluator_version": {
      "const": "stage1-evaluator-v1"
    },
    "mode": {
      "enum": [
        "consistency",
        "intent_quality"
      ]
    },
    "sample_id": {
      "type": "string",
      "minLength": 1
    },
    "manuscript_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "runtime_label": {
      "type": "string",
      "minLength": 1
    },
    "prompt_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "chapter_intent": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intent"
          }
        },
        "prose_quality": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/quality"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "consistency"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "report": {
            "required": [
              "findings"
            ],
            "properties": {
              "chapter_intent": {
                "maxItems": 0
              },
              "prose_quality": {
                "maxItems": 0
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "mode": {
            "const": "intent_quality"
          }
        },
        "required": [
          "mode"
        ]
      },
      "then": {
        "properties": {
          "report": {
            "required": [
              "chapter_intent",
              "prose_quality"
            ],
            "properties": {
              "findings": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "quote"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "chapter",
        "primary_category",
        "severity",
        "asserted_status",
        "proposition",
        "evidence_current",
        "conflict_source",
        "epistemic_status",
        "rationale",
        "confidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "primary_category": {
          "enum": [
            "FACTUAL_ENTITY",
            "CHARACTER_STATE",
            "RELATIONSHIP",
            "WORLD_RULE",
            "TEMPORAL",
            "LOCATION",
            "OBJECT_OWNERSHIP",
            "EPISTEMIC",
            "OPEN_LOOP"
          ]
        },
        "secondary_categories": {
          "type": "array",
          "items": {
            "enum": [
              "FACTUAL_ENTITY",
              "CHARACTER_STATE",
              "RELATIONSHIP",
              "WORLD_RULE",
              "TEMPORAL",
              "LOCATION",
              "OBJECT_OWNERSHIP",
              "EPISTEMIC",
              "OPEN_LOOP"
            ]
          },
          "uniqueItems": true
        },
        "severity": {
          "enum": [
            "MATERIAL",
            "MINOR",
            "ADVISORY"
          ]
        },
        "asserted_status": {
          "enum": [
            "ASSERTED",
            "UNRESOLVED"
          ]
        },
        "proposition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_current": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "conflict_source": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "invariant_source": {
          "enum": [
            "IMMUTABLE_SEED",
            "PRIOR_PROSE",
            "SAME_CHAPTER_PROSE",
            "NONE"
          ]
        },
        "epistemic_status": {
          "enum": [
            "OBJECTIVE",
            "ATTRIBUTED_CLAIM",
            "UNRESOLVED",
            "NOT_APPLICABLE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "objective_status",
        "rationale"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "objective_status": {
          "enum": [
            "SATISFIED",
            "PARTIAL",
            "MISSED",
            "CONTRADICTED",
            "AMBIGUOUS"
          ]
        },
        "intended_changes_status": {
          "type": "array",
          "items": {
            "enum": [
              "REALIZED",
              "NOT_REALIZED",
              "AMBIGUOUS",
              "NOT_APPLICABLE"
            ]
          }
        },
        "open_constraint_status": {
          "enum": [
            "PRESERVED",
            "VIOLATED",
            "AMBIGUOUS",
            "NOT_APPLICABLE"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chapter",
        "clarity",
        "scene_coherence",
        "characterization",
        "pacing",
        "language_quality",
        "overall_reader_quality"
      ],
      "properties": {
        "chapter": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "clarity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "scene_coherence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "characterization": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "pacing": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "language_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "overall_reader_quality": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "comment": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
