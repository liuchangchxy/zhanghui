# Reference repository moved to ~/References/ai-webnovel-repos/ (2026-08-12)
# — no longer needs gitignore exclusion since it's outside the repo.

# Upstream skills / plugin sources pulled in for reference only
.claude/sources/

# Vendored plugin (kept in git so `git clone` actually works — self-use)
# 取消下面这行以让 .claude/plugins/ 跟着 git 走（M-C1 修复）
# .claude/plugins/

# Python / Node build artifacts
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Backup directory (no longer used — git is at root)
/.claude-backup/

# 项目级状态指针（指向本机绝对路径，不应进 git）
.claude/.webnovel-current-project
