# Reference repository moved to ~/References/ai-webnovel-repos/ (2026-08-12)
# — no longer needs gitignore exclusion since it's outside the repo.

# Upstream skills / plugin sources pulled in for reference only
.claude/sources/

# Vendored plugin (kept in git so `git clone` actually works — self-use)
# 取消下面这行以让 .claude/plugins/ 跟着 git 走（M-C1 修复）
# .claude/plugins/

# Python / Node build artifacts
__pycache__/
*.pyc
.pytest_cache/
node_modules/

# OS / editor cruft
.DS_Store
*.swp
.idea/
.vscode/

# Backup directory (no longer used — git is at root)
/.claude-backup/

# 项目级状态指针（指向本机绝对路径，不应进 git）
.claude/.webnovel-current-project

# Snapshot 目录：每个章节一份完整副本，会膨胀仓库且与项目本身重复
.webnovel/snapshots/

# Git worktrees (per using-git-worktrees skill)
.worktrees/
.claude/worktrees/

# Python package build artifacts (egg-info, dist, build)
*.egg-info/
dist/
build/

# ── 参考库：第三方项目只读快照 ──────────────────────────
# 2.1GB / 49396 文件 / 含 20+ 个嵌套 .git（别人仓库的完整克隆）
# 仅本地开发调研用，永不进 git：既超 GitHub 体积上限，
# 也是再分发他人代码。本地保留，详见 references/INDEX.md
references/
